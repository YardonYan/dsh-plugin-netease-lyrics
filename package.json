{
  "name": "dsh-plugin-netease-lyrics",
  "version": "1.0.2",
  "description": "Netease Cloud Music lyrics beside the DSH activity line, disguised as part of it.",
  "license": "MIT",
  "author": "Yardon",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "smtc-worker.ps1", "cordis.patch.yml", "locale/*.json", "icon.svg", "docs/*.png", "README.md", "LICENSE"],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/apply-guard.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["dsh", "dsh-plugin", "netease", "lyrics", "lrc", "smtc", "windows"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YardonYan/dsh-plugin-netease-lyrics.git"
  },
  "bugs": {
    "url": "https://github.com/YardonYan/dsh-plugin-netease-lyrics/issues"
  },
  "homepage": "https://github.com/YardonYan/dsh-plugin-netease-lyrics#readme",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
